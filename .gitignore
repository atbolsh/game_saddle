# Trained LoRA adapter checkpoints (weights/<architecture>/<name>/); on the
# local editing box "weights" is a symlink onto removable storage, so the
# pattern has no trailing slash (a slash-pattern would not match the symlink).
weights

# Materialized external replay datasets (training/datasets.json describes
# them; scripts/setup_env.sh downloads them). Same no-trailing-slash reason
# as weights: locally this is a symlink onto removable storage.
data_external

# Generated self-eval game traces (training/generate_game_traces.py writes
# them). Same no-trailing-slash reason: locally a symlink onto removable
# storage.
data_game

# Per-run logs: LLM-call logs, DB-retrieval logs, and .dump snapshots
logs/
*.dump
